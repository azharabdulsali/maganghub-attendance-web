# ---------------------------------------------------------------------------
# RAHASIA, ini yang paling penting.
# Ditulis lebih dulu sebelum `git init` supaya tidak ada satu detik pun
# di mana .env bisa ikut ter-commit. Lihat SPEC.md §9 dan §14 Tahap B.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Jangan pernah commit file kunci / kredensial lain
*.pem
*.key
*.p12
.neon

# ---------------------------------------------------------------------------
# Node / Next.js
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js

.next/
out/
build/
dist/
next-env.d.ts

# Cache
.turbo/
.vercel/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Vercel / Neon CLI (bila nanti dipakai)
# ---------------------------------------------------------------------------
.vercel
.neon

# ---------------------------------------------------------------------------
# Prisma
# ---------------------------------------------------------------------------
prisma/migrations/dev.db
*.db
*.db-journal

# ---------------------------------------------------------------------------
# Log & OS
# ---------------------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Editor
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# File sementara saat pengembangan
dev-log.txt
dev-err.txt
vt-full.txt
vt-*.txt

# ---------------------------------------------------------------------------
# Graphify (peta kode / knowledge graph - lihat CLAUDE.md & CODEBUDDY.md)
#
# Output graphify DILACAK supaya agent (dan manusia) punya peta kode yang sama.
# Yang diabaikan hanya cache SHA256 + penanda internal: sifatnya lokal, besar,
# dan berubah tiap run tanpa nilai bila di-commit.
# ---------------------------------------------------------------------------
graphify-out/cache/
graphify-out/.graphify_root

# ---------------------------------------------------------------------------
# Tangkapan layar MENTAH sebelum disanitasi (penting, lihat riwayat 0edfdf8).
#
# Tiga gambar `public/panduan/devtools-*.webp` JUSTRU memang dilacak git: file
# itu dipakai `src/lib/guides.ts` dan harus ada agar halaman panduan ter-render
# di production. Karena itu folder itu TIDAK boleh di-ignore seluruhnya.
#
# Bahayanya ada pada gambar MENTAH / hasil ekspor ulang yang belum dibersihkan:
# bila berisi nilai token sungguhan, meng-commit-nya sama dengan membocorkan
# sesi (pernah terjadi di repo publik ini). Simpan file kerja seperti itu dengan
# pola nama di bawah, yang di-ignore, lalu baru salin versi bersih ke nama
# final `devtools-N-buka.webp`.
# ---------------------------------------------------------------------------
public/panduan/mentah/
public/panduan/*-mentah.*
public/panduan/*-raw.*
public/panduan/*-unsanitized.*
public/panduan/*.psd
public/panduan/*.xcf
