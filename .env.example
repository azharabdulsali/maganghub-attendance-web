# Salin file ini menjadi `.env.local` lalu isi nilainya.
# File ini AMAN di-commit karena tidak berisi rahasia.
# `.env.local` TIDAK boleh di-commit (lihat .gitignore).

# Neon — proyek flat-term-91348789, region ap-southeast-1 (Singapore)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# NextAuth v5
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Enkripsi kredensial Monev — 32 byte acak, 64 karakter hex.
# JANGAN pernah ganti setelah ada data tersimpan.
ENCRYPTION_KEY=""

# Email admin pertama — pendaftar dengan email ini otomatis jadi ADMIN.
ADMIN_EMAIL=""

# Gerbang keselamatan pengiriman NYATA ke portal Monev (Tahap 4).
# Biarkan kosong / tidak "1" selama pengembangan: route /api/reports/submit
# DAN webhook /api/cron/submit (Tahap 5) berjalan dalam mode latihan (dry-run)
# dan TIDAK menyentuh portal.
# Set "1" HANYA saat benar-benar siap mengirim laporan sungguhan.
ALLOW_LIVE_SUBMIT=""

# Rate limit (Tahap 5, SPEC.md §10 poin 6) — OPSIONAL.
# Bila DIBIARKAN KOSONG: pembatas memakai memori proses (cukup untuk dev / 1
# instance) — TIDAK akurat lintas instance Vercel.
# Isi keduanya untuk pembatas terpusat yang akurat di produksi (Upstash Redis,
# ada paket gratis). Nilai dari dashboard Upstash → REST API.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


# Dispatcher cron massal (Tahap 6) - OPSIONAL.
# Satu pemicu admin (mis. GitHub Actions) memanggil GET /api/cron/run-all
# tiap jam dengan header 'Authorization: Bearer <CRON_SECRET>'. Server lalu
# mengirim laporan untuk SEMUA user yang jam jadwalnya = jam sekarang.
# Dengan ini user TIDAK perlu menyalin webhook / memasang cron sendiri.
# Kosongkan untuk menonaktifkan dispatcher (endpoint balas 503).
CRON_SECRET=""
